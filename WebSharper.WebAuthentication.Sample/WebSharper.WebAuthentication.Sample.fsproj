<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- System.Text.Json / System.Reflection.Emit.Lightweight are framework
         packages on net10.0; Paket still surfaces them as references. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Client.fs" />
    <Compile Include="Startup.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebSharper.WebAuthentication.Extensions\WebSharper.WebAuthentication.Extensions.fsproj" />
    <ProjectReference Include="..\WebSharper.WebAuthentication\WebSharper.WebAuthentication.fsproj" />
  </ItemGroup>

  <Import Project="..\.paket\Paket.Restore.targets" />

</Project>
